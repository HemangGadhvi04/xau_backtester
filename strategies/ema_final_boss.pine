//@version=5
strategy("7 EMA Final Boss - Quantified", overlay=true, margin_long=100, margin_short=100, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100)

// -----------------------------------------------------------------------------
// Parameters
// -----------------------------------------------------------------------------
emaLength = input.int(7, "EMA Length", group="Moving Averages")
htf = input.timeframe("60", "Higher Timeframe", group="Moving Averages")

rr = input.float(3.0, "Risk/Reward Ratio", group="Trade Management")

adxLen = input.int(14, "ADX Length", group="Trend Filter")
adxThresh = input.int(25, "ADX Threshold", group="Trend Filter")

// -----------------------------------------------------------------------------
// Indicators
// -----------------------------------------------------------------------------
ema15m = ta.ema(close, emaLength)
// Fetch HTF EMA (using [1] to avoid lookahead bias)
ema1H = request.security(syminfo.tickerid, htf, ta.ema(close, emaLength)[1], barmerge.gaps_off, barmerge.lookahead_on) 

// ADX Filter
[diplus, diminus, adx] = ta.dmi(adxLen, adxLen)
isTrending = adx > adxThresh

// -----------------------------------------------------------------------------
// Setup Conditions
// -----------------------------------------------------------------------------
htfBull = close > ema1H
htfBear = close < ema1H

// Pullback logic: pierced the LTF EMA but closed back on the correct side
pullbackLong = low <= ema15m and close > ema15m
pullbackShort = high >= ema15m and close < ema15m

// SL logic: Lowest low / Highest high of the last 5 bars
swingLow = ta.lowest(low, 5)
swingHigh = ta.highest(high, 5)

// -----------------------------------------------------------------------------
// Execution Logic
// -----------------------------------------------------------------------------
if (htfBull and pullbackLong and isTrending and strategy.position_size == 0)
    sl = swingLow
    // Prevent Division by Zero if spread/wicks are wild
    if sl < close
        risk = close - sl
        tp = close + (risk * rr)
        strategy.entry("Long", strategy.long)
        strategy.exit("Exit Long", "Long", stop=sl, limit=tp)

if (htfBear and pullbackShort and isTrending and strategy.position_size == 0)
    sl = swingHigh
    if sl > close
        risk = sl - close
        tp = close - (risk * rr)
        strategy.entry("Short", strategy.short)
        strategy.exit("Exit Short", "Short", stop=sl, limit=tp)

// -----------------------------------------------------------------------------
// Visuals
// -----------------------------------------------------------------------------
plot(ema15m, color=color.blue, title="LTF EMA (15m)")
plot(ema1H, color=color.orange, linewidth=2, title="HTF EMA (1H)")

// Plot entry shapes for visual confirmation
plotshape(htfBull and pullbackLong and isTrending and strategy.position_size == 0, title="Long Signal", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small)
plotshape(htfBear and pullbackShort and isTrending and strategy.position_size == 0, title="Short Signal", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small)
