# .env.example

# --- Application Setup ---
# The environment type (development, production)
ENV=production

# --- Database Setup (PostgreSQL) ---
# When running via docker-compose, this connects to the postgres service
DATABASE_URL=postgresql+psycopg2://titan_user:titan_password@db:5432/titan_db

# --- Redis Setup ---
# When running via docker-compose, this connects to the redis service
REDIS_URL=redis://redis:6379/0

# --- Security ---
# Secret key used for signing JWT authentication tokens.
# IN PRODUCTION: Generate a secure random string and replace this value!
# Example: openssl rand -hex 32
JWT_SECRET=your_secure_random_string_here

# --- Frontend URL ---
# The URL where the frontend is hosted, used for CORS headers
FRONTEND_URL=http://localhost
